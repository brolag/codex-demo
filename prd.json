      "tests": ["backend/test_main.py::TestCreateExpense"],
      "passes": true
    },
    {
      "id": "feat-002",
      "title": "List expenses",
      "description": "GET /expenses - Return all expenses",
      "files": ["backend/main.py", "frontend/src/App.jsx"],
      "tests": ["backend/test_main.py::TestListExpenses"],
      "passes": true
    },
    {
      "id": "feat-003",
      "title": "Get expense by ID",
      "description": "GET /expenses/:id - Return a specific expense by its ID",
      "files": ["backend/main.py"],
      "tests": ["backend/test_main.py::TestGetExpense"],
      "passes": false
    },
    {
      "id": "feat-004",
      "title": "Update expense",
      "description": "PUT /expenses/:id - Update an existing expense",
      "files": ["backend/main.py"],
      "tests": ["backend/test_main.py::TestUpdateExpense"],
      "passes": false
    },
    {
      "id": "feat-005",
      "title": "Delete expense",
